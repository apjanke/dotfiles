#!/bin/bash
#
# run-tests - exercise install-dotfiles against a throwaway $HOME
#
# Usage: ./dotfiles/tests/run-tests
#
# Exits non-zero if any assertion fails, so it is usable from CI.
#
# Everything happens under a temp dir used as $HOME. Nothing here touches the real one.

set -o errexit
set -o nounset
set -o pipefail

cd "$(dirname "$0")/../.."
REPO="$PWD"

function ok() {
  TESTS=$((TESTS + 1))
  printf '  ok   %s\n' "$1"
}

function fail() {
  TESTS=$((TESTS + 1))
  FAILS=$((FAILS + 1))
  printf '  FAIL %s\n' "$1"
  if [[ $# -ge 2 ]]; then
    printf '         %s\n' "$2"
  fi
}

function assert_symlink_to() {
  # assert_symlink_to <path-under-fake-home> <expected-target> <description>
  local path="$FAKE_HOME/$1" want="$2" desc="$3" got
  if [[ ! -L "$path" ]]; then
    fail "$desc" "not a symlink: $path"
    return
  fi
  got=$(readlink "$path")
  if [[ "$got" != "$want" ]]; then
    fail "$desc" "points at $got, wanted $want"
    return
  fi
  if [[ ! -e "$path" ]]; then
    fail "$desc" "symlink is dangling: $path -> $got"
    return
  fi
  ok "$desc"
}

function assert_real_dir() {
  local path="$FAKE_HOME/$1" desc="$2"
  if [[ -d "$path" && ! -L "$path" ]]; then
    ok "$desc"
  else
    fail "$desc" "not a real directory: $path"
  fi
}

function assert_absent() {
  local path="$FAKE_HOME/$1" desc="$2"
  if [[ -e "$path" || -L "$path" ]]; then
    fail "$desc" "exists but should not: $path"
  else
    ok "$desc"
  fi
}

function assert_contains() {
  local haystack="$1" needle="$2" desc="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    ok "$desc"
  else
    fail "$desc" "output did not contain: $needle"
  fi
}

FAKE_HOMES=()

# shellcheck disable=SC2329  # reached via the EXIT trap below; shellcheck doesn't follow it
function cleanup() {
  local d
  for d in ${FAKE_HOMES+"${FAKE_HOMES[@]}"}; do
    case "$d" in                                            # only ever rm what mktemp made
      */dotfiles-test.*) rm -rf "$d" ;;
      *) echo >&2 "refusing to remove unexpected path: $d" ;;
    esac
  done
}
trap cleanup EXIT

function new_fake_home() {
  FAKE_HOME=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-test.XXXXXX")
  FAKE_HOMES+=("$FAKE_HOME")
}

function install_into_fake_home() {
  # errexit off: failures are the caller's to interpret, not ours to abort on.
  local rc=0
  set +o errexit
  HOME="$FAKE_HOME" "$REPO/install-dotfiles" "$@" 2>&1
  rc=$?
  set -o errexit
  return $rc
}

function real_bashrc_link() {
  readlink "$HOME/.bashrc" 2>/dev/null || echo '(not a symlink)'
}

# ============ Tests ============

function run_tests() {
  local out out2 before rc stale

  echo "===== a clean install ====="
  new_fake_home
  install_into_fake_home > /dev/null

  assert_symlink_to '.bashrc'    "$REPO/dotfiles/generic/flat/bashrc.sh"  'flat tree: .bashrc links to bashrc.sh'
  assert_symlink_to '.profile'   "$REPO/dotfiles/generic/flat/profile.sh" 'flat tree: .profile links to profile.sh'
  assert_symlink_to '.zshrc'     "$REPO/dotfiles/generic/flat/zshrc.zsh"  'munging: .zshrc comes from zshrc.zsh'
  assert_symlink_to '.hushlogin' "$REPO/dotfiles/generic/flat/hushlogin"  'no extension to strip: .hushlogin'
  assert_symlink_to '.gitconfig' "$REPO/dotfiles/macos/flat/gitconfig"    'OS-specific file shadows generic: .gitconfig'
  assert_symlink_to '.dots'      "$REPO/dotfiles/generic/flat/dots"       'a directory in the flat tree links whole: .dots'

  assert_symlink_to '.config/btop/btop.conf'   "$REPO/dotfiles/generic/deep/_config/btop/btop.conf"  'deep tree: nested file is linked'
  assert_symlink_to '.config/fish/config.fish' "$REPO/dotfiles/generic/deep/_config/fish/config.fish" 'deep tree: another nested file'
  assert_symlink_to '.config/htop/htoprc'      "$REPO/dotfiles/generic/deep/_config/htop/htoprc"     'deep tree: two levels deep'
  assert_real_dir   '.config'                                                      'deep tree: .config is a real dir, not a link'
  assert_real_dir   '.config/btop'                                                 'deep tree: intermediate dirs are real'

  assert_absent '.gitkeep' 'literal-dot repo file (macos/deep/.gitkeep) is never linked'

  # The trees are siblings so the flat scanner can't see deep/ as an entry to link. This
  # used to produce a bogus ~/._deep when deep/ lived inside the flat namespace.
  assert_absent '.deep'  'the deep/ tree is not itself linked into ~'
  assert_absent '._deep' 'no leftover ._deep from the old carve-out layout'
  assert_absent '.flat'  'the flat/ tree is not itself linked into ~'

  assert_symlink_to 'bin' "$REPO/bin" 'the ~/bin dir links to the repo bin/'

  echo "===== the invocation path doesn't leak into the links ====="
  # install_into_fake_home calls the installer by absolute path, so nothing above here
  # exercises a relative invocation -- which is how the README says to run it, and which
  # used to write a self-referential "./bin" into ~/bin.
  new_fake_home
  ( cd "$REPO" && HOME="$FAKE_HOME" ./install-dotfiles ) > /dev/null 2>&1
  assert_symlink_to 'bin' "$REPO/bin" 'run as ./install-dotfiles, ~/bin is still absolute'
  new_fake_home
  ( cd "$REPO/dotfiles" && HOME="$FAKE_HOME" ../install-dotfiles ) > /dev/null 2>&1
  assert_symlink_to 'bin' "$REPO/bin" 'run from a subdir as ../install-dotfiles, likewise'
  assert_symlink_to '.bashrc' "$REPO/dotfiles/generic/flat/bashrc.sh" \
    'relative invocation gets the flat tree right too'

  echo "===== underscore-to-dot munging ====="
  mkdir -p "$REPO/dotfiles/generic/deep/_munge-test/completions"
  echo 'test content' > "$REPO/dotfiles/generic/deep/_munge-test/_leaf"
  # Shaped like the case this escape exists for: a zsh completion function, whose name
  # really does start with an underscore.
  echo 'compdef stub' > "$REPO/dotfiles/generic/deep/_munge-test/completions/__zcomp"
  install_into_fake_home > /dev/null
  assert_symlink_to '.munge-test/.leaf' "$REPO/dotfiles/generic/deep/_munge-test/_leaf" \
    'both a dir and a leaf file with a leading _ munge to a leading .'
  assert_symlink_to '.munge-test/completions/_zcomp' \
    "$REPO/dotfiles/generic/deep/_munge-test/completions/__zcomp" \
    'a leading __ escapes to a literal leading _'
  rm -rf "$REPO/dotfiles/generic/deep/_munge-test"

  echo "===== \$OSNAME shadows generic in the deep tree ====="
  new_fake_home
  mkdir -p "$REPO/dotfiles/macos/deep/_config/btop"
  echo 'macos override' > "$REPO/dotfiles/macos/deep/_config/btop/btop.conf"
  install_into_fake_home > /dev/null
  assert_symlink_to '.config/btop/btop.conf' "$REPO/dotfiles/macos/deep/_config/btop/btop.conf" \
    'macos/deep overrides generic/deep on a matching target'
  rm -rf "$REPO/dotfiles/macos/deep/_config"

  echo "===== idempotence ====="
  new_fake_home
  install_into_fake_home > /dev/null
  out2=$(install_into_fake_home -v)
  assert_contains "$out2" "Symlink '.bashrc' is already set up" 'second run reports flat-tree file unchanged'
  assert_contains "$out2" "Symlink '.config/btop/btop.conf' is already set up" 'second run reports deep-tree file unchanged'
  if [[ "$(readlink "$FAKE_HOME/.bashrc")" == "$REPO/dotfiles/generic/flat/bashrc.sh" ]]; then
    ok 'second run left the link pointing where it was'
  else
    fail 'second run left the link pointing where it was'
  fi

  echo "===== a regular file is not clobbered ====="
  new_fake_home
  echo 'hand-written, do not touch' > "$FAKE_HOME/.bashrc"
  out=$(install_into_fake_home)
  assert_contains "$out" "SKIPPED: File '.bashrc' is a regular file" 'regular file is reported as skipped'
  if [[ "$(cat "$FAKE_HOME/.bashrc")" == 'hand-written, do not touch' ]]; then
    ok 'regular file kept its contents'
  else
    fail 'regular file kept its contents'
  fi

  echo "===== the flat-tree collision guard ====="
  new_fake_home
  install_into_fake_home > /dev/null
  before=$(readlink "$FAKE_HOME/.bashrc")
  stale="$REPO/dotfiles/generic/flat/bashrc.zsh"  # stale rename leftover; both munge to .bashrc
  echo '# stale leftover from a rename' > "$stale"
  rc=0
  out=$(install_into_fake_home) || rc=$?
  rm -f "$stale"
  if [[ $rc -ne 0 ]]; then
    ok 'collision makes the installer exit non-zero'
  else
    fail 'collision makes the installer exit non-zero' "exited 0"
  fi
  assert_contains "$out" 'both install as' 'collision is explained in the error'
  if [[ "$(readlink "$FAKE_HOME/.bashrc")" == "$before" ]]; then
    ok 'collision changed nothing in ~ (validation runs before linking)'
  else
    fail 'collision changed nothing in ~ (validation runs before linking)' \
      "was $before, now $(readlink "$FAKE_HOME/.bashrc")"
  fi

  echo "===== the real \$HOME was never touched ====="
  # Compare against a snapshot taken before any test ran, rather than against the current
  # repo layout. Comparing to the layout conflates two things, and trips on a rearranged
  # tree or a home that just needs a re-install -- neither of which says anything about
  # whether the tests escaped their fake $HOME, which is the only thing this guards.
  if [[ "$(real_bashrc_link)" == "$REAL_BASHRC_BEFORE" ]]; then
    ok "the real ~/.bashrc is exactly as the tests found it"
  else
    fail "the real ~/.bashrc is exactly as the tests found it" \
      "was $REAL_BASHRC_BEFORE, now $(real_bashrc_link)"
  fi
}

function print_summary() {
  echo
  if [[ $FAILS -eq 0 ]]; then
    echo "===== all $TESTS assertions passed ====="
  else
    echo "===== $FAILS of $TESTS assertions FAILED ====="
  fi
}

# ============ Main script ============

REAL_BASHRC_BEFORE=$(real_bashrc_link)   # snapshot before anything runs

TESTS=0
FAILS=0
run_tests
print_summary
exit $(( FAILS > 0 ? 1 : 0 ))
