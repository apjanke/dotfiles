#!/bin/bash
#
# findd - find, with same dir & file exclusions as grin
#
# See bashyrc.sh for the related grin command and its friends, and grin-excludes.sh for the
# $JX_GRIN_EXCLUDE_DIRS/$JX_GRIN_EXCLUDE_FILES this reads and why they are scalars.

set -o errexit
set -o nounset
set -o pipefail
if [[ ${TRACE:-0} == "1" ]]; then set -o xtrace; fi

# Load JXL, for jxl::strsplit. See "Loading JXL" in dots/README.md.
source "$(cd "$(dirname "$0")" && pwd -P)/../dots/all-os/flat/dotlib/jxl-lib.sh" \
    || { echo >&2 "findd: ERROR: failed to load jxl-lib.sh"; exit 1; }
# Fills in the exclusion defaults only if the calling shell did not already export them.
source "$(cd "$(dirname "$0")" && pwd -P)/../dots/all-os/flat/dotlib/grin-excludes.sh" \
    || { echo >&2 "findd: ERROR: failed to load grin-excludes.sh"; exit 1; }

function main {
  if [[ $# -eq 0 ]]; then
    echo >&2 'findd: error: must supply at least 1 argument'
    return 1
  fi

  # Split "$@" into args1 (find's own [-H|-L|-P] [-EXdsx]-style leading options, plus the
  # path(s)) and args2 (the expression). Purely positional: anything before the first
  # non-"-" arg is a leading option, then paths until the first "-"-looking arg; args2 starts
  # there. Doesn't bother special-casing value-taking leading options like GNU find's
  # "-D debugopts", or a path that itself starts with "-" and requires '-f <path>'. Those are
  # edge cases.
  #TODO: Do bother with the special case handling for the edge cases.
  local -a args1=() args2=()
  local a path_seen=0 in_expr=0
  for a in "$@"; do
    if [[ $in_expr == 1 ]]; then
      args2+=( "$a" )
    elif [[ $path_seen == 1 && $a == -* ]]; then
      in_expr=1; args2+=( "$a" )
    else
      args1+=( "$a" )
      [[ $a == -* ]] || path_seen=1
    fi
  done

  # Have to build the arg list manually-ish bc of find's syntax
  local d f first=1
  local -a excl_dirs excl_files
  jxl::strsplit excl_dirs  "${JX_GRIN_EXCLUDE_DIRS:-}"
  jxl::strsplit excl_files "${JX_GRIN_EXCLUDE_FILES:-}"

  # Each clause is conditional: find rejects an empty "( )" group with "empty inner
  # expression", and an empty exclusion list is a thing a user can now set.
  local -a prune_expr=()
  if [[ ${#excl_dirs[@]} -gt 0 ]]; then
    prune_expr+=( -type d '(' )
    for d in "${excl_dirs[@]}"; do
      if [[ $first -eq 0 ]]; then prune_expr+=( -or ); fi
      prune_expr+=( -name "$d" )
      first=0
    done
    prune_expr+=( ')' -prune )
  fi
  for f in ${excl_files[@]+"${excl_files[@]}"}; do
    if [[ ${#prune_expr[@]} -gt 0 ]]; then prune_expr+=( -or ); fi
    prune_expr+=( -name "$f" )
  done

  # Without an explicit action here, find's implicit default -print applies to the
  # -prune branch too, so excluded dirs still show up in the output themselves. But if the
  # caller already passed an action of their own, adding -print on top double-prints.
  local has_action=0
  for a in ${args2[@]+"${args2[@]}"}; do
    case "$a" in
      -print | -print0 | -printf | -fprint | -fprint0 | -fprintf \
          | -ls | -fls | -exec | -execdir | -ok | -okdir | -delete | -quit)
        has_action=1; break ;;
    esac
  done
  local -a tail_expr=( ${args2[@]+"${args2[@]}"} )
  if [[ $has_action == 0 ]]; then tail_expr+=( -print ); fi

  if [[ ${#prune_expr[@]} -gt 0 ]]; then
    find "${args1[@]}" \( "${prune_expr[@]}" \) -or \( "${tail_expr[@]}" \)
  else
    find "${args1[@]}" "${tail_expr[@]}"
  fi
}


# ========== Main script ==========

main "$@"
