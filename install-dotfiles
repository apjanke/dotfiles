#!/bin/bash
#
# install-dotfiles
#
# Installs symlinks to dotfiles in this repo into current user's $HOME dir.
#
# Clobbers any existing dotfiles, iff they're currently symlinks. Does not check to see
# if those symlinks are pointing to what looks like this dotfiles repo or a variant
# of it, so be careful. Does not clobber non-symlink regular files.
#
# Two source trees, siblings under each `dotfiles/<osname>/` root. ("generic" applies to
# all OSes; per-OS entries take precedence over it in both trees.)
#
#   <osname>/flat/   Entries map to ~/.<name>, linked whole -- a directory here becomes
#                    one symlink, which is how ~/.dots works. A leading dot is always
#                    added, and a .sh/.zsh/.bash extension is stripped.
#   <osname>/deep/   Mirrors $HOME. Parent dirs are created for real, leaf regular files
#                    are symlinked. Per path component, `_x` installs as `.x` and `__x`
#                    escapes to a literal `_x`. Components that really start with a dot
#                    are this repo's own control files (.gitkeep) and are skipped.
#
# Name munging exists so the repo holds no dotfiles of its own except real repo-control
# ones. The two trees munge differently because they differ: every flat entry becomes a
# ~/.foo, so the dot is implicit and needs no marker, while in deep/ only some components
# are dotted, so they have to be marked. See dotfiles/README.md for the longer version.

set -o errexit
set -o nounset
set -o pipefail
if [[ "${TRACE-0}" == "1" ]]; then set -o xtrace; fi

PROGRAM_NAME=$(basename "$0")

#TODO: Replace this v_echo() with my standard info/warn/die/verbose/emit functions.
function v_echo() {
  if [[ $VERBOSE == 1 ]]; then
    echo "$@"
  fi
}

function symlink() {
  local source="$1" target="$2"
  local current_source
  if [[ -L "$target" ]]; then
    current_source=$(readlink "$target")
    if [[ "$current_source" == "$source" ]]; then
      v_echo "Symlink '$target' is already set up"
      return
    fi
  elif [[ -d "$target" && ! -L "$target" ]]; then
    echo >&2 "ERROR: '$target' is a non-symlink directory"
    exit 1
  elif [[ -f "$target" ]]; then
    echo "SKIPPED: File '$target' is a regular file"
    return
  fi
  ln -sfn "$source" "$target"
  printf '%-18s -> %s\n' "$target" "$source"
  CHANGED=1
}

function detect_os_type() {
  # Post: $OSNAME is set, or script has exited with an error status
  uname=$(uname)
  case $uname in
    Darwin)
      # Apple renamed "Mac OS X" to "macOS" at some point; accept both.
      if which sw_vers &>/dev/null && [[ $(sw_vers -productName) == "Mac OS X" || $(sw_vers -productName) == "macOS" ]]; then
        OSNAME=macos
      else
        OSNAME=darwin
      fi
      ;;
    *)
      OSNAME="$uname"
      ;;
  esac
}

function install_dotfiles_flat() {
  # dotfiles/{generic,$OSNAME}/flat/ -> ~/.foo. Pre: cwd is $HOME. Reads $dotdir, $OSNAME.
  local dotfiles file tofile fromfile seen_targets=""
  local genericdir="$dotdir/generic/flat" osdir="$dotdir/$OSNAME/flat"

  if [[ -d "$osdir" ]]; then
      # shellcheck disable=SC2207
      dotfiles=( $( (ls "$genericdir"; ls "$osdir") | sort | uniq ) )
  else
      # shellcheck disable=SC2207
      dotfiles=($(ls "$genericdir"))
  fi

  # Catch e.g. a stale zshrc.sh next to zshrc.zsh before linking anything.
  for file in "${dotfiles[@]}"; do
    tofile=$(munge_dotfile_name "$file")
    if [[ " $seen_targets " == *" $tofile "* ]]; then
      echo >&2 "ERROR: two source files in $dotdir both install as '$tofile'"
      echo >&2 "       Nothing was changed. Most likely a rename left a stale file behind."
      exit 1
    fi
    seen_targets+=" $tofile"
  done

  for file in "${dotfiles[@]}"; do
    tofile=$(munge_dotfile_name "$file")
    if [[ -e "$osdir/$file" ]]; then
      fromfile="$osdir/$file"
    else
      fromfile="$genericdir/$file"
    fi
    symlink "$fromfile" "$tofile"
  done
}

function munge_dotfile_name() {
  # Turn a flat-tree source filename into the name it installs as in ~.
  #
  # Use a case rather than the tidier extglob one-liner ".${1%.@(sh|zsh|bash)}" bc
  # extglob is off by default in bash and you get wrong names.
  case "$1" in
    *.sh)    echo ".${1%.sh}"   ;;
    *.zsh)   echo ".${1%.zsh}"  ;;
    *.bash)  echo ".${1%.bash}" ;;
    *)       echo ".$1"         ;;
  esac
}

function install_dotfiles_deep() {
  # dotfiles/{generic,$OSNAME}/deep/, munged via munge_deep_path. $OSNAME overrides
  # generic on a matching target. Pre: cwd is $HOME. Reads $dotdir, $OSNAME.
  local tier srcdir file relpath tofile dir i found
  local -a targets=() sources=()

  for tier in generic "$OSNAME"; do
    srcdir="$dotdir/$tier/deep"
    [[ -d "$srcdir" ]] || continue
    while IFS= read -r -d '' file; do
      relpath="${file#"$srcdir"/}"
      tofile=$(munge_deep_path "$relpath")
      found=-1
      for i in "${!targets[@]}"; do
        [[ "${targets[$i]}" == "$tofile" ]] && { found=$i; break; }
      done
      if [[ $found -ge 0 ]]; then
        sources[found]="$file"
      else
        targets+=("$tofile")
        sources+=("$file")
      fi
    done < <(find "$srcdir" -type f ! -path '*/.*' -print0 | sort -z)  # skip repo-control dotfiles
  done

  for i in "${!targets[@]}"; do
    tofile="${targets[$i]}"
    dir=$(dirname "$tofile")
    if [[ "$dir" != "." && ! -d "$dir" ]]; then
      mkdir -p "$dir"
      v_echo "Created directory '$dir'"
      case "$dir" in
        .ssh | .ssh/* | .gnupg | .gnupg/*) chmod 700 "$dir" ;;  # sshd StrictModes
      esac
    fi
    symlink "${sources[$i]}" "$tofile"
  done
}

function munge_deep_path() {
  # deep-relative path -> installed path, per component: _x -> .x, __x -> _x, x -> x.
  local relpath="$1" part out=""
  local IFS=/
  local -a parts
  read -ra parts <<< "$relpath"
  for part in "${parts[@]}"; do
    # __x first, so it can't fall through to the _x arm. Escapes names that really do
    # start with an underscore, like zsh completion functions (_git, _docker).
    case "$part" in
      __*) part="${part#_}"  ;;
      _*)  part=".${part#_}" ;;
    esac
    out="${out:+$out/}$part"
  done
  echo "$out"
}

function install_bin() {
  # repo bin/ -> ~/bin. Pre: cwd is $HOME. Reads $dotfiles_repo_dir.
  CHANGED=0
  symlink "${dotfiles_repo_dir}/bin" "bin"
  if [[ $CHANGED == 1 ]]; then
    echo "Linked the ~/bin directory. Don't forget to add it to your \$PATH."
  fi
}

function main() {
  if [[ $OPT_TRACE = 1 ]]; then
    set -o xtrace
  fi
  # Absolute, so the links we write don't depend on the cwd we were invoked from. Run as
  # `./install-dotfiles`, a relative $sourcedir put a literal "./bin" in ~/bin, which from
  # ~ points at itself.
  sourcedir=$(cd "$(dirname "$0")" && pwd)
  dotfiles_repo_dir="$sourcedir"
  dotdir="$sourcedir/dotfiles"
  todir=$HOME

  detect_os_type

  (
    CHANGED=0
    cd "$todir"

    install_dotfiles_flat
    install_dotfiles_deep
    install_bin
  )

  echo "Dotfiles are now linked to $dotdir."

}

function usage() {
  cat <<EOF
$PROGRAM_NAME - install dotfile symlinks to the repo this script is in

Usage:
  $PROGRAM_NAME [-x] [-v]
  $PROGRAM_NAME -h

Options:
    -h    display help
    -v    verbose output
    -x    trace program execution
EOF
}

# ========== Main script ==========

function parse_cli() {
  VERBOSE=0
  OPT_TRACE=0
  #TODO: Add support for long options. Drop getopts; I've decided I don't like it.
  #TODO: Move this cmdline parsing to a function
  while getopts vxh opt; do
    case $opt in
      v) VERBOSE=1 ;;
      x) OPT_TRACE=1 ;;
      h) usage; exit 0 ;;
      \?)
        echo >&2 "See '$PROGRAM_NAME -h' for usage"
        exit 1 ;;
    esac
  done
}

parse_cli "$@"
main
exit 0
