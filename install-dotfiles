#!/bin/bash
#
# install-dotfiles
#
# Installs symlinks to dotfiles in this repo into current user's $HOME dir.
#
# Clobbers any existing dotfiles, iff they're currently symlinks. Does not check to see
# if those symlinks are pointing to what looks like this dotfiles repo or a variant
# of it, so be careful. Does not clobber non-symlink regular files.
#
# Two source trees, siblings under each `dots/<osname>/` root. ("all-os" applies to
# all OSes; per-OS entries take precedence over it in both trees.)
#
#   <osname>/flat/     Entries map to ~/.<name>, linked whole -- a directory here becomes
#                      one symlink, which is how ~/.dotlib works. A leading dot is always
#                      added, and a .sh/.zsh/.bash extension is stripped.
#   <osname>/nested/   Mirrors $HOME. Parent dirs are created for real, leaf regular files
#                      are symlinked. Per path component, `_x` installs as `.x` and `__x`
#                      escapes to a literal `_x`. Components that really start with a dot
#                      are this repo's own control files (.gitkeep) and are skipped.
#
# Name munging exists so the repo holds no dotfiles of its own except real repo-control
# ones. The two trees munge differently because they differ: every flat entry becomes a
# ~/.foo, so the dot is implicit and needs no marker, while in nested/ only some
# components are dotted, so they have to be marked. See dots/README.md for the longer
# version.

set -o errexit
set -o nounset
set -o pipefail
if [[ "${TRACE-0}" == "1" ]]; then set -o xtrace; fi


function usage() {
  cat <<EOF
$PROGRAM_NAME - install dotfile symlinks to the repo this script is in

Usage:
  $PROGRAM_NAME [--trace] [--verbose]
  $PROGRAM_NAME --help

Options:
    -h, --help       display help
    -v, --verbose    verbose output
    -x, --trace      trace program execution
EOF
}

VERBOSE=0 DEBUG=0 OPT_TRACE=0

ANY_CHANGED=0 ALREADY=0 SKIPPED=0 FAILED=0

function main() {
  if [[ $OPT_TRACE = 1 ]]; then
    set -o xtrace
  fi
  # Absolute, so the links we write don't depend on the cwd we were invoked from. Run as
  # `./install-dotfiles`, a relative $sourcedir put a literal "./bin" in ~/bin, which from
  # ~ points at itself.
  sourcedir=$(cd "$(dirname "$0")" && pwd)
  dotfiles_repo_dir="$sourcedir"
  dotdir="$sourcedir/dots"
  todir=$HOME

  detect_os_type
  cd "$todir"

  install_dotfiles_flat
  install_dotfiles_nested
  install_bin

  local msg='' rc=0
  if [[ $ANY_CHANGED == 0 ]]; then
    msg=$(append_msg "$msg" 'All links were already up to date.')
  fi
  if [[ $SKIPPED != 0 ]]; then
    msg=$(append_msg "$msg" "Skipped $SKIPPED files.")
  fi
  if [[ $FAILED != 0 ]]; then
    rc=1
    info "FAILED linking $FAILED files."
  fi
  info "$msg"

  info "Dotfiles are now linked to $dotdir."
  exit "$rc"
}

function append_msg () {
  # Append a string, with space separator.
  local msg="$1" add="$2"
  if [[ -n $add ]]; then
    [[ -n $msg ]] && msg+=' '
    msg+="$add"
  fi
  echo "$msg"
}

function parse_cli() {
  local arg

  while [[ $# -ge 1 ]]; do
    arg="$1"; shift
    case "$arg" in
      --verbose | -v)               VERBOSE=1 ;;
      --trace | -x)                 OPT_TRACE=1 ;;
      --help | -help | -h | '-?')   usage; exit 0 ;;
      *)
        die "Unexpected argument: ${arg}. See '$PROGRAM_NAME --help' for usage" ;;
    esac
  done

  readonly VERBOSE OPT_TRACE
}

# ========== Generic boilerplate and utilities ==========

PROGRAM_NAME=$(basename "$0")

function info()    { emit "$*"; }
function log_vrb() { if is_verbose; then info "$@"; fi; }
function log_dbg() { if is_debug; then info "debug: $*"; fi; }
function warning() { emit "WARNING: $*"; }
function error()   { emit "ERROR: $*"; }
function die()     { error "$@"; exit 1; }
function emit()    { echo >&2 "$*"; }

function is_verbose() { if [[ "${VERBOSE:-0}" != 0 ]]; then return 0; else return 1; fi; }
function is_debug() { if [[ "${DEBUG:-0}" != 0 ]]; then return 0; else return 1; fi; }


# ========== Script-specific code ==========

function symlink() {
  # out: $ANY_CHANGED, $THIS_CHANGED, $ALREADY, $SKIPPED, $FAILED
  local source="$1" target="$2"
  THIS_CHANGED=0
  local current_source='' descr
  descr=$(printf '%-18s -> %s\n' "$target" "$source")
  if [[ -L "$target" ]]; then
    current_source=$(readlink "$target")
    if [[ "$current_source" == "$source" ]]; then
      log_vrb "Already set up: $descr"
      ALREADY=$((ALREADY + 1))
    fi
  elif [[ -e "$target" && ! -L "$target" ]]; then
    local file_type
    if [[ -f "$target" ]]; then
      file_type='regular file'
    elif [[ -d "$target" ]]; then
      file_type='non-symlink directory'
    else
      file_type='file of some sort (neither regular file nor symlink)'
    fi
    info "SKIPPED: $target is a $file_type"
    SKIPPED=$((SKIPPED + 1))
  else
    # Main case: do the linking
    if ln -sfn "$source" "$target"; then
      ANY_CHANGED=1; THIS_CHANGED=1
      info "Linked: $descr"
    else
      FAILED=$((FAILED + 1))
      error "Failed: $descr"
    fi
  fi
}

function detect_os_type() {
  # Post: $OSNAME is set, or script has exited with an error status
  uname=$(uname)
  case $uname in
    Darwin)
      # Apple renamed "Mac OS X" to "macOS" at some point; accept both.
      if which sw_vers &>/dev/null && [[ $(sw_vers -productName) == "Mac OS X" || $(sw_vers -productName) == "macOS" ]]; then
        OSNAME=macos
      else
        OSNAME=darwin
      fi
      ;;
    *)
      OSNAME="$uname"
      ;;
  esac
}

function install_dotfiles_flat() {
  # dots/{all-os,$OSNAME}/flat/ -> ~/.foo. Pre: cwd is $HOME. Reads $dotdir, $OSNAME.
  local dotfiles file tofile fromfile seen_targets=""
  local allosdir="$dotdir/all-os/flat" osdir="$dotdir/$OSNAME/flat"

  if [[ -d "$osdir" ]]; then
      # shellcheck disable=SC2207
      dotfiles=( $( (ls "$allosdir"; ls "$osdir") | sort | uniq ) )
  else
      # shellcheck disable=SC2207
      dotfiles=($(ls "$allosdir"))
  fi

  # Catch e.g. a stale zshrc.sh next to zshrc.zsh before linking anything.
  for file in "${dotfiles[@]}"; do
    tofile=$(munge_dotfile_name "$file")
    if [[ " $seen_targets " == *" $tofile "* ]]; then
      die "ERROR: Two source files in $dotdir both install as '$tofile'." \
          "Nothing was changed. Most likely a rename left a stale file behind."
    fi
    seen_targets+=" $tofile"
  done

  for file in "${dotfiles[@]}"; do
    tofile=$(munge_dotfile_name "$file")
    if [[ -e "$osdir/$file" ]]; then
      fromfile="$osdir/$file"
    else
      fromfile="$allosdir/$file"
    fi
    symlink "$fromfile" "$tofile"
  done
}

function munge_dotfile_name() {
  # Turn a flat-tree source filename into the name it installs as in ~.
  #
  # Use a case rather than the tidier extglob one-liner ".${1%.@(sh|zsh|bash)}" bc
  # extglob is off by default in bash and you get wrong names.
  local name="$1"
  case "$name" in
    *.sh)    echo ".${name%.sh}"   ;;
    *.zsh)   echo ".${name%.zsh}"  ;;
    *.bash)  echo ".${name%.bash}" ;;
    *)       echo ".$name"         ;;
  esac
}

function install_dotfiles_nested() {
  # dots/{all-os,$OSNAME}/nested/, munged via munge_nested_path. $OSNAME overrides all-os
  # on a matching target. Pre: cwd is $HOME. Reads $dotdir, $OSNAME.
  local tier srcdir file relpath tofile dir i found
  local -a targets=() sources=()

  for tier in all-os "$OSNAME"; do
    srcdir="$dotdir/$tier/nested"
    [[ -d "$srcdir" ]] || continue
    while IFS= read -r -d '' file; do
      relpath="${file#"$srcdir"/}"
      tofile=$(munge_nested_path "$relpath")
      found=-1
      for i in "${!targets[@]}"; do
        [[ "${targets[$i]}" == "$tofile" ]] && { found=$i; break; }
      done
      if [[ $found -ge 0 ]]; then
        sources[found]="$file"
      else
        targets+=("$tofile")
        sources+=("$file")
      fi
    done < <(find "$srcdir" -type f ! -path '*/.*' -print0 | sort -z)  # skip repo-control dotfiles
  done

  for i in "${!targets[@]}"; do
    tofile="${targets[$i]}"
    dir=$(dirname "$tofile")
    if [[ "$dir" != "." && ! -d "$dir" ]]; then
      mkdir -p "$dir"
      log_vrb "Created directory '$dir'"
      case "$dir" in
        .ssh | .ssh/* | .gnupg | .gnupg/*) chmod 700 "$dir" ;;  # sshd StrictModes
      esac
    fi
    symlink "${sources[$i]}" "$tofile"
  done
}

function munge_nested_path() {
  # nested-relative path -> installed path, per component: _x -> .x, __x -> _x, x -> x.
  local relpath="$1" part out=""
  local IFS=/
  local -a parts
  read -ra parts <<< "$relpath"
  for part in "${parts[@]}"; do
    # __x first, so it can't fall through to the _x arm. Escapes names that really do
    # start with an underscore, like zsh completion functions (_git, _docker).
    case "$part" in
      __*) part="${part#_}"  ;;
      _*)  part=".${part#_}" ;;
    esac
    out="${out:+$out/}$part"
  done
  echo "$out"
}

function install_bin() {
  # repo home-bin/ -> ~/bin. Pre: cwd is $HOME. Reads $dotfiles_repo_dir.
  local THIS_CHANGED
  symlink "${dotfiles_repo_dir}/home-bin" "bin"
  if [[ $THIS_CHANGED == 1 ]]; then
    echo "Linked the ~/bin directory. Don't forget to add it to your \$PATH."
  fi
}


# ========== Main script ==========

parse_cli "$@"
main   # exits with its own status; nothing here is reachable
