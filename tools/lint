#!/bin/bash
#
# lint - static-check the shell scripts in this repo
#
# Usage:
#   tools/lint                     # check everything
#   tools/lint (--list | -l)       # just list what would be checked
#   tools/lint (--list-type | -t)  # the same list, grouped by dialect
#   tools/lint FILE...             # check only these
#
# Exits non-zero if any checker reports anything, so it is usable from CI.
#
# Scripts are found by extension (.sh/.bash/.ksh/.zsh) or, for extensionless files, by
# reading the shebang -- the repo has a dozen-plus extensionless bash scripts in
# home-bin-jx/, sys-setup/, and the root, and one Perl one, so "has a shebang" is not a
# sufficient test.
#
# Split by dialect, because shellcheck has no zsh mode: it parses zsh as bash and reports
# artifacts of that rather than real problems (an anonymous `() { ... }` function trips
# SC1073). So bash/sh goes to shellcheck, and zsh gets `zsh -n`, which is syntax-only but
# is the best available.
#
# A third bucket, "bashy": the files both shells source -- ~/.profile and the ~/.dotlib
# pieces under it. They have to parse under both, so they get every bash check AND
# `zsh -n`. A file joins that bucket by carrying a marker comment line reading
# `jx-lint-shells: bash zsh`; see is_dual_shell for why it is self-declared.
#
# bash/sh files also get `bash -n` and a grep pass for constructs that need a bash newer
# than the 3.2 macOS ships. The grep is a blacklist and knows only what's in its table, so
# a clean run proves nothing on its own -- see run_bash3_compat_check for why nothing
# better exists.

set -o errexit
set -o nounset
set -o pipefail

PROGRAM_PATH="$0"
PROGRAM_NAME=$(basename "$0")
readonly PROGRAM_PATH PROGRAM_NAME

function info()  { emit "$*"; }
function error() { emit "ERROR: $*"; }
function warn()  { emit "WARNING: $*"; }
function die()   { error "$*"; exit 1; }
function emit()  { echo >&2 "${PROGRAM_NAME}: $*"; }

function usage() {
  cat <<EOF
$PROGRAM_NAME - static-check the shell scripts in this repo

Usage:
  $PROGRAM_NAME [--list | --list-type] [FILE...]
  $PROGRAM_NAME --help

Options:
    -l, --list       list the files that would be checked, and exit
    -t, --list-type  the same list, grouped by dialect, and exit
    -h, --help       display help

--list and --list-type are the same selection shown two ways, so the last one given wins
rather than both printing.

bash/sh files go to shellcheck and 'bash -n'; zsh files get 'zsh -n', since shellcheck
has no zsh dialect. bash/sh files are also scanned for constructs requiring a bash newer
than 3.2; that scan is a best-effort blacklist, not a guarantee.

Suppress a bash-3.2 finding with a '# jx-lint-ok: bash4' comment on the line, or
'# jx-lint-ok-file: bash4' anywhere in a file to exempt the whole file.

Mark a file that both shells source with a '# jx-lint-shells: bash zsh' comment line;
it then gets the bash checks and 'zsh -n' both.
EOF
}

FILE_ARGS=()
# none | plain | typed. One variable rather than a flag per listing style, so --list and
# --list-type cannot both be on at once and there is no "which wins" case to resolve.
OPT_LIST_MODE=none

function main() {
  local -a sh_targets=() zsh_targets=() bashy_targets=()
  local file rc=0

  cd "$(dirname "$PROGRAM_PATH")/.."

  if [[ ${#FILE_ARGS[@]} -gt 0 ]]; then
    # An explicitly named file gets checked whatever it is; the classifier only picks
    # which checker to use, defaulting to shellcheck.
    for file in "${FILE_ARGS[@]}"; do
      case $(script_kind "$file") in
        zsh)   zsh_targets+=("$file")   ;;
        bashy) bashy_targets+=("$file") ;;
        *)     sh_targets+=("$file")    ;;
      esac
    done
  else
    while IFS= read -r -d '' file; do sh_targets+=("$file");    done < <(collect_targets sh)
    while IFS= read -r -d '' file; do zsh_targets+=("$file");   done < <(collect_targets zsh)
    while IFS= read -r -d '' file; do bashy_targets+=("$file"); done < <(collect_targets bashy)
  fi

  if [[ ${#sh_targets[@]} -eq 0 && ${#zsh_targets[@]} -eq 0 && ${#bashy_targets[@]} -eq 0 ]]; then
    die "no shell scripts found"
  fi

  if [[ $OPT_LIST_MODE == plain ]]; then
    if [[ ${#sh_targets[@]}    -gt 0 ]]; then printf '%s\n' "${sh_targets[@]}";    fi
    if [[ ${#zsh_targets[@]}   -gt 0 ]]; then printf '%s\n' "${zsh_targets[@]}";   fi
    if [[ ${#bashy_targets[@]} -gt 0 ]]; then printf '%s\n' "${bashy_targets[@]}"; fi
    return 0
  fi

  if [[ $OPT_LIST_MODE == typed ]]; then
    # Labelled by dialect rather than by the internal bucket names: "bash+zsh" says what
    # the constraint on those files actually is, where "bashy" only makes sense if you
    # already know this script.
    if [[ ${#sh_targets[@]}    -gt 0 ]]; then print_bucket 'bash'     "${sh_targets[@]}";    fi
    if [[ ${#zsh_targets[@]}   -gt 0 ]]; then print_bucket 'zsh'      "${zsh_targets[@]}";   fi
    if [[ ${#bashy_targets[@]} -gt 0 ]]; then print_bucket 'bash+zsh' "${bashy_targets[@]}"; fi
    return 0
  fi

  # A dual-shell file has to parse under both, so it joins both lists rather than picking
  # one. Merged after the listing above, so -l shows each file once rather than twice.
  if [[ ${#bashy_targets[@]} -gt 0 ]]; then
    sh_targets+=("${bashy_targets[@]}")
    zsh_targets+=("${bashy_targets[@]}")
  fi

  if [[ ${#sh_targets[@]} -gt 0 ]]; then
    run_shellcheck "${sh_targets[@]}" || rc=1
    run_bash_syntax_check "${sh_targets[@]}" || rc=1
    run_bash3_compat_check "${sh_targets[@]}" || rc=1
  fi
  if [[ ${#zsh_targets[@]} -gt 0 ]]; then
    run_zsh_syntax_check "${zsh_targets[@]}" || rc=1
  fi
  return $rc
}

function parse_cli() {
  local arg

  while [[ $# -ge 1 ]]; do
    arg="$1"; shift
    case "$arg" in
      --list | -l)                  OPT_LIST_MODE=plain ;;
      --list-type | -t)             OPT_LIST_MODE=typed ;;
      --help | -help | -h | '-?')   usage; exit 0 ;;
      --)                           break ;;
      -*)
        die "Unexpected option: ${arg}. See '$PROGRAM_NAME --help' for usage" ;;
      *)                            FILE_ARGS+=("$arg") ;;
    esac
  done
  # Whatever followed a `--` is a file name, however option-like it looks.
  FILE_ARGS+=("$@")

  readonly OPT_LIST_MODE FILE_ARGS
}

function print_bucket() {
  # print_bucket LABEL FILE... -- a dialect heading with its files indented under it.
  #
  # Callers skip empty buckets rather than calling with no files, so a dialect nothing
  # uses prints no heading at all, instead of a bare label with nothing beneath it.
  local label="$1"; shift
  printf '%s:\n' "$label"
  printf '  %s\n' "$@"
}

function run_shellcheck() {
  local rc=0
  shellcheck "$@" || rc=$?
  if [[ $rc == 0 ]]; then
    info "shellcheck: clean ($# files)"
  fi
  return $rc
}

function run_bash_syntax_check() {
  # bash -n parses without executing. Mostly redundant with shellcheck, which cannot
  # analyze a file it cannot parse -- but only mostly: shellcheck brings its own parser
  # rather than bash's, so the two can disagree, and this catches the case where the
  # disagreement is shellcheck's fault. Cheap enough that the overlap doesn't matter.
  #
  # (A comment line here must not begin with the word "shellcheck": it gets read as a
  # directive, and a malformed one is a hard SC1072 parse error. Hence the rewrap.)
  local file rc=0
  for file in "$@"; do
    bash -n "$file" || rc=1
  done
  if [[ $rc == 0 ]]; then
    info "bash -n: clean ($# files)"
  fi
  return $rc
}

function run_zsh_syntax_check() {
  # zsh -n parses without executing. Syntax only: no style or quoting analysis, so this
  # is not a shellcheck equivalent. There isn't one -- shellcheck has no zsh dialect --
  # and this at least catches what breaks shell startup. Less is lost than it looks:
  # most of shellcheck's value is word-splitting warnings, and zsh doesn't word-split
  # unquoted expansions in the first place.
  local file rc=0
  if ! command -v zsh >/dev/null 2>&1; then
    warn "zsh not found; skipped $# zsh file(s)"
    return 0
  fi
  for file in "$@"; do
    zsh -n "$file" || rc=1
  done
  if [[ $rc == 0 ]]; then
    info "zsh -n: clean ($# files)"
  fi
  return $rc
}

function run_bash3_compat_check() {
  # Flag constructs needing a bash newer than the 3.2 macOS ships as /bin/bash.
  #
  # Nothing else catches these. They are *runtime* failures, not parse errors -- bash 3.2
  # parses the newer forms happily and only objects when the line executes -- and so
  # `bash -n` under 3.2 exits 0 on all of them. shellcheck has no version targeting:
  # --shell takes only sh/bash/dash/ksh/busybox, and --shell=sh is no proxy, since it
  # rejects plain arrays and [[ ]] too.
  #
  # A blacklist: it knows what's in BASH4_CONSTRUCTS and nothing else, so a clean run is
  # not a portability guarantee. Add entries as new traps turn up.
  local i pat descr file line raw hits skipped rc=0 grep_rc nl=$'\n'
  local -a targets=()

  if (( ${#BASH4_CONSTRUCTS[@]} % 2 != 0 )); then
    die "BASH4_CONSTRUCTS is malformed: odd entry count (want pattern/description pairs)"
  fi

  # Unlike the pattern loop below, a failure here needs no check: an empty skip list just
  # means everything gets checked, so the worst case is a spurious finding, not a miss.
  skipped=$(grep -lE "$BASH4_SKIP_FILE_RE" -- "$@") || true
  for file in "$@"; do
    case "$nl$skipped$nl" in
      *"$nl$file$nl"*) continue ;;
    esac
    targets+=("$file")
  done
  if [[ ${#targets[@]} -eq 0 ]]; then
    info "bash 3.2 compat: every file opted out ($# files)"
    return 0
  fi

  for ((i = 0; i < ${#BASH4_CONSTRUCTS[@]}; i += 2)); do
    pat="${BASH4_CONSTRUCTS[i]}"
    descr="${BASH4_CONSTRUCTS[i+1]}"
    grep_rc=0
    raw=$(grep -nHE -- "$pat" "${targets[@]}") || grep_rc=$?
    # 1 is "no match"; anything higher is a real failure and must not read as clean.
    if [[ $grep_rc -gt 1 ]]; then
      die "grep exited $grep_rc on pattern: $pat"
    fi
    [[ -n $raw ]] || continue
    hits=""
    while IFS= read -r line; do
      if [[ $line =~ $BASH4_SKIP_LINE_RE ]]; then continue; fi
      hits="${hits:+$hits$nl}    $line"
    done <<< "$raw"
    if [[ -n $hits ]]; then
      printf '%s\n%s\n' "$descr" "$hits"
      rc=1
    fi
  done

  if [[ $rc == 0 ]]; then
    info "bash 3.2 compat: clean (${#targets[@]} files)"
  fi
  return $rc
}

# Pattern/description pairs, walked with a stride of 2, since bash 3.2 has no associative
# arrays. Interleaved rather than two parallel arrays so a pattern and its description
# can't drift apart: with two arrays, adding an entry to one and not the other misaligns
# every description after it and mislabels findings forever without failing.
#
# Some patterns bracket a character ([s]hopt, [&]>>) purely so the pattern text doesn't
# match itself when the linter checks this file. Where that wasn't practical, the
# description carries a jx-lint-ok marker instead.
#
# shellcheck disable=SC2016  # the ${...} in the descriptions is prose, not an expansion
BASH4_CONSTRUCTS=(
  '(^|[^[:alnum:]_./-])(declare|local|typeset)[[:space:]]+-[a-zA-Z]{0,3}A([[:space:]]|$)'
      'bash 4.0: associative arrays (declare -A)'
  '(^|[^[:alnum:]_./-])(mapfile|readarray)([[:space:]]|$)'
      'bash 4.0: mapfile / readarray'  # jx-lint-ok: bash4
  '\$\{[!#]?[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?(,|\^)'
      'bash 4.0: case modification ${var,,} and ${var^^}'  # jx-lint-ok: bash4
  '\|[&]'
      'bash 4.0: |& pipe of stdout and stderr (use 2>&1 |)'  # jx-lint-ok: bash4
  '[&]>>'
      'bash 4.0: &>> append of stdout and stderr (use >>file 2>&1)'  # jx-lint-ok: bash4
  '(^|[^[:alnum:]_])coproc([[:space:]]|$)'
      'bash 4.0: coproc'
  # One entry per introducing version, not one per construct kind: the version is the
  # actionable half of a finding, since it decides what the guard around the line has to
  # test. Lumping these three groups together cost real time -- the merged entry read
  # "4.0/4.2" and left progcomp_alias, actually a 5.0 option, looking covered by a 4.x
  # guard. So the three shopt entries stay adjacent for scanning, each naming one version.
  #
  # Verified against the bash 3.2 through 5.2 docker images rather than the man page,
  # which documents no version history. progcomp is present in every one of those builds,
  # so progcomp_alias being absent before 5.0 is the option's age, not a stripped build.
  '[s]hopt[^#]*(globstar|autocd|checkjobs|dirspell)'
      'bash 4.0: shell options globstar, autocd, checkjobs, dirspell'
  '[s]hopt[^#]*lastpipe'
      'bash 4.2: shell option lastpipe'
  '[s]hopt[^#]*progcomp_alias'
      'bash 5.0: shell option progcomp_alias'
  ';;?[&]'
      'bash 4.0: case fallthrough ;& and ;;&'  # jx-lint-ok: bash4
  '(^|[^[:alnum:]_./-])(declare|typeset)[[:space:]]+-[a-zA-Z]{0,3}g([[:space:]]|$)'
      'bash 4.2: declare -g'
  '(^|[^[:alnum:]_./-])(\[\[|\[|test)[[:space:]]+-v[[:space:]]'
      'bash 4.2: [[ -v var ]] (use [[ -n ${var+x} ]])'  # jx-lint-ok: bash4
  'printf[^#]*%\([^)]*\)T'
      'bash 4.2: printf %()T time formatting'  # jx-lint-ok: bash4
  '(^|[^[:alnum:]_./-])(declare|local|typeset)[[:space:]]+-[a-zA-Z]{0,3}n([[:space:]]|$)'
      'bash 4.3: namerefs (declare -n)'
  '(^|[^[:alnum:]_])wait[[:space:]]+-n([[:space:]]|$)'
      'bash 4.3: wait -n'
  '\$\{[!#]?[A-Za-z_][A-Za-z0-9_]*(\[[^]]*\])?@[a-zA-Z]\}'
      'bash 4.4: parameter transformations ${var@Q}'  # jx-lint-ok: bash4
  '\$\{?(EPOCHSECONDS|EPOCHREALTIME|BASH_ARGV0)([^A-Za-z0-9_]|$)'
      'bash 5.0: EPOCHSECONDS, EPOCHREALTIME, BASH_ARGV0'
  # SRANDOM shipped a release after the three above, not alongside them.
  '\$\{?SRANDOM([^A-Za-z0-9_]|$)'
      'bash 5.1: SRANDOM'
)

# The colon is part of the name here, so the -file form doesn't also register as the
# per-line form -- it contains the per-line name as a prefix. Naming the check (bash4)
# keeps room for a second one later.
#
# The file form is anchored to a line holding nothing but the marker, because an
# unanchored match exempts any file that so much as documents the directive -- this one
# did exactly that, silently skipping itself, until the anchors went in.
BASH4_SKIP_LINE_RE='jx-lint-ok:[[:space:]]*bash4'
BASH4_SKIP_FILE_RE='^[[:space:]]*#[[:space:]]*jx-lint-ok-file:[[:space:]]*bash4$'

function collect_targets() {
  # Emits NUL-delimited paths of the given kind, sorted. Kind is "sh", "zsh", or "bashy".
  # Pre: cwd is the repo root.
  local want="$1" file
  # /local and /zz-local are gitignored scratch dirs, not part of the project.
  find . \( -name .git -o -name zz-local -o -name local \) -prune -o -type f -print0 \
    | while IFS= read -r -d '' file; do
        if [[ $(script_kind "$file") == "$want" ]]; then
          printf '%s\0' "$file"
        fi
      done \
    | sort -z
}

function script_kind() {
  # Echoes "sh" for anything shellcheck can parse, "zsh" for zsh, "bashy" for a file both
  # shells source, nothing otherwise.
  local file="$1" base interp
  base=${file##*/}
  case "$base" in
    *.zsh)                 echo zsh  ; return ;;
    *.sh | *.bash | *.ksh)
      if is_dual_shell "$file"; then echo bashy; else echo sh; fi
      return ;;
    *.*)                               return ;;   # some other extension; not ours
  esac
  # Extensionless. The marker is read before the shebang, not after, because a file meant
  # to be sourced rather than run has no shebang to read.
  if is_dual_shell "$file"; then echo bashy; return; fi
  interp=$(shebang_interp "$file")
  case "$interp" in
    sh | bash | ksh | dash | ash) echo sh  ;;
    zsh)                          echo zsh ;;
  esac
}

function is_dual_shell() {
  # True if the file declares itself sourced by both bash and zsh, and so obliged to
  # parse under both.
  #
  # Self-declaration rather than a list of paths kept here, because a path list goes
  # stale on a rename with nothing to notice: the predecessor script carried exactly such
  # a list, the tree was restructured out from under it, and the whole dual-shell check
  # quietly stopped covering anything.
  #
  # No head/pipe: `head -n N | grep -q` can leave head killed by SIGPIPE once grep matches
  # and exits, and under `set -o pipefail` that turns a match into a nonzero return. These
  # files are small enough that reading them whole costs nothing.
  grep -qsE -- "$DUAL_SHELL_RE" "$1"
}

# Anchored to a line holding nothing but the marker, the way BASH4_SKIP_FILE_RE is, so a
# file that merely mentions the directive does not register as carrying it. Note the
# regex would happily match this script: every reference to it here is worded so the
# marker never begins a line.
DUAL_SHELL_RE='^[[:space:]]*#[[:space:]]*jx-lint-shells:[[:space:]]*bash[[:space:]]+zsh[[:space:]]*$'

function shebang_interp() {
  # Echoes the interpreter's basename from the file's shebang, or nothing.
  local file="$1"
  local first interp
  local -a words
  IFS= read -r first < "$file" || return 0
  case "$first" in '#!'*) ;; *) return 0 ;; esac
  # shellcheck disable=SC2206  # splitting the shebang line into words is the point
  words=(${first#\#!})
  [[ ${#words[@]} -gt 0 ]] || return 0
  interp=${words[0]##*/}
  # `#!/usr/bin/env bash`: the real interpreter is the next word.
  if [[ "$interp" == env && ${#words[@]} -gt 1 ]]; then
    interp=${words[1]##*/}
  fi
  printf '%s\n' "$interp"
}

# ========== Main script ==========

parse_cli "$@"
main
exit $?
